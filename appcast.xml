        <item>
            <title>1.17.34</title>
            <pubDate>Thu, 19 Nov 2026 10:35:06 -0600</pubDate>
            <link>https://github.com/dankelleghan-ops/yak-releases</link>
            <sparkle:version>104</sparkle:version>
